# Auto detect text files and perform LF normalization
# ★ 强制工作区统一 LF：仓库主体在 Linux 侧，Windows/SMB 挂载下 autocrlf
#   会产生大量幻影改动与 "LF will be replaced by CRLF" 告警
* text=auto eol=lf
models/reranker/*.safetensors filter=lfs diff=lfs merge=lfs -text
models/reranker/onnx/*.onnx filter=lfs diff=lfs merge=lfs -text
models/reranker/openvino/*.bin filter=lfs diff=lfs merge=lfs -text
models/reranker/openvino/*.xml filter=lfs diff=lfs merge=lfs -text
