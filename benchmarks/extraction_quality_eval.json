{
  "name": "extraction_quality_eval_v1",
  "version": "1.0",
  "description": "OmniMem 事实抽取质量评测集 — 100条中文对话，标注「该记/不该记」事实",
  "scoring": {
    "precision": "提取的事实中，正确（在 should_extract 中）的比例",
    "recall": "should_extract 中被提取到的比例",
    "f1": "精确率和召回率的调和平均",
    "false_positive_rate": "不应记但被提取的比例"
  },
  "schema": {
    "id": "唯一标识",
    "dialogue": "用户对话文本",
    "dialogue_context": "对话场景说明（可选）",
    "should_extract": ["应该提取为记忆的事实"],
    "should_not_extract": ["不应该提取的内容"],
    "tags": ["分类标签"],
    "capability": "能力维度: information_extraction|knowledge_update|temporal|preference|personal_info|refusal"
  },
  "capability_distribution": {
    "information_extraction": 25,
    "knowledge_update": 20,
    "temporal": 15,
    "preference": 20,
    "personal_info": 15,
    "refusal": 5
  },
  "items": [
